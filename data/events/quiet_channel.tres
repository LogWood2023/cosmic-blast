effects = [{"action": "grant_minerals", "amount_by_stage": PackedInt32Array(24, 36, 54)}]
[resource]
script = ExtResource("1")
event_id = "quiet_channel"
title = "静默航道"
narrative = "一条安静航道愿意替你避开一次战斗。"
category = "world"
theme_tags = PackedStringArray("route", "reward")
options = [SubResource("A"), SubResource("B")]
