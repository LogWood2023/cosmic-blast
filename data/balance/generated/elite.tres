unit = "seconds"
data_type = "float"
formula = "elite_ehp/normal_build_dps"
notes = "目标约1分钟"

[sub_resource type="Resource" id="Resource_lohqc"]
script = ExtResource("1_om71i")
schema_version = "1.0"
domain = "elite"
kind = "target"
record_id = "elite_room_probability"
