[sub_resource type="Resource" id="Resource_un0cr"]
script = ExtResource("1_om71i")
schema_version = "1.0"
domain = "elite"
kind = "budget"
record_id = "elite_ehp"
display_name = "精英有效生命"
raw_stage_values = PackedStringArray("4800", "9600", "20400")
unit = "ehp"
data_type = "int"
formula = "round(normal_build_dps*60)"
notes = "含护盾闪现和不可攻击时间"

[sub_resource type="Resource" id="Resource_21111"]
script = ExtResource("1_om71i")
schema_version = "1.0"
domain = "elite"
kind = "target"
record_id = "elite_ttk"
display_name = "精英目标TTK"
