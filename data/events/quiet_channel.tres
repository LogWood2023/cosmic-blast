[gd_resource type="Resource" script_class="EventDefinition" load_steps=4 format=3]
[ext_resource type="Script" path="res://scripts/data/events/EventDefinition.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/events/EventOptionData.gd" id="2"]
[sub_resource type="Resource" id="A"]
script = ExtResource("2")
option_id = "reroute"
title = "转入静默航道"
description = "将一次战斗机会换成奖励路线。"
preview_text = "签订路线变更协议。"
duration_nodes = 1
effects = [{"action": "add_event_contract", "payload": {"id": "quiet_channel", "effect_type": "battle_to_reward"}}]
[sub_resource type="Resource" id="B"]
script = ExtResource("2")
option_id = "hold"
title = "维持航图"
description = "不更改路线，出售静默数据。"
